{
	"compilerOptions": {
		"target": "ES2021",
		"module": "ES2020",
		"moduleResolution": "node",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"declaration": false,
		"strict": true,
		"noImplicitAny": true,
		"experimentalDecorators": true,
		"useDefineForClassFields": false,
		"outDir": "./dist",
		"sourceMap": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}

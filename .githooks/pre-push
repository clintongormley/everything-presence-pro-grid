#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
FRONTEND="$ROOT/frontend"
LOG_FILE="/tmp/epp-pre-push.log"
failed=0

# Mirror all output to a log file so post-mortem doesn't require re-running.
# Overwritten on every push — the last run's output is always at $LOG_FILE.
exec > >(tee "$LOG_FILE") 2>&1

step() { printf '\n\033[1;34m▶ %s\033[0m\n' "$1"; }
fail() { printf '\033[1;31m✗ %s\033[0m\n' "$1"; failed=1; }
pass() { printf '\033[1;32m✓ %s\033[0m\n' "$1"; }

# -- Docs --
# Block structural changes (file add/rename/delete) to doc-described surface
# area without a corresponding architecture.md / data-catalog.md update.
# Pure modifications produce a soft warning. See scripts/check-docs-update.sh.

remote="$1"
url="$2"
upstream_ref=$(git rev-parse --verify "$remote/$(git branch --show-current)" 2>/dev/null || echo "")

if [ -n "$upstream_ref" ]; then
    DIFF_RANGE="$upstream_ref..HEAD"
else
    # No upstream yet — check all commits on branch vs default branch
    base=$(git merge-base HEAD main 2>/dev/null || git merge-base HEAD master 2>/dev/null || echo "")
    if [ -n "$base" ]; then
        DIFF_RANGE="$base..HEAD"
    else
        DIFF_RANGE="HEAD~1..HEAD"
    fi
fi

changed_files=$(git diff --name-only "$DIFF_RANGE" 2>/dev/null || echo "")

# Only run a language's (slower) gates when files for that language changed —
# the cheap docs/translations drift checks below always run.
py_changed=$(echo "$changed_files" | grep -E '\.py$' || true)
ts_changed=$(echo "$changed_files" | grep -E '^frontend/' || true)

step "Docs check"
if bash "$ROOT/scripts/check-docs-update.sh" "$DIFF_RANGE"; then
    pass "Docs check"
else
    fail "Docs check — see message above"
fi

step "Docs formatting"
# Portable equivalent of the CI docs job's mdformat gate (wrap=80 from
# .mdformat.toml + the gfm/mkdocs plugins). We avoid `xargs -r` (a GNU
# extension that BSD/macOS xargs rejects) by guarding the empty case here.
# mdformat ships in requirements-docs.txt, so skip with a warning if it isn't
# installed rather than blocking a push (matches the lcov guard below).
if command -v mdformat >/dev/null 2>&1; then
    md_files=$(git ls-files -- docs README.md | { grep '\.md$' || true; })
    if [ -z "$md_files" ] || printf '%s\n' "$md_files" | xargs mdformat --check 2>&1; then
        pass "Docs formatting"
    else
        fail "Docs formatting — run: git ls-files -- docs README.md | grep '\.md$' | xargs mdformat"
    fi
else
    printf '  \033[1;33m⚠  mdformat not installed — skipping (pip install -r requirements-docs.txt)\033[0m\n'
fi

entity_files="custom_components/eppgrid/(sensor|binary_sensor|config_flow|__init__)\.py"
changed_entity_files=$(echo "$changed_files" | grep -E "$entity_files" || true)
if [ -n "$changed_entity_files" ]; then
    step "Strings check"
    # Only require a strings.json update when the diff actually touches lines
    # that typically correspond to strings.json entries. Touching setup or
    # wiring code in these files doesn't necessarily mean user-facing strings
    # changed.
    strings_patterns='translation_key|step_id=|reason=|vol\.(Required|Optional)\(|async_abort\(|async_show_form\('
    touches_strings=false
    for f in $changed_entity_files; do
        if git diff "$DIFF_RANGE" -- "$f" | grep -E '^[+-][^+-]' | grep -qE "$strings_patterns"; then
            touches_strings=true
            break
        fi
    done
    if [ "$touches_strings" = true ]; then
        if echo "$changed_files" | grep -q "strings.json"; then
            pass "strings.json updated"
        else
            fail "Entity/config files changed with potential new user-facing strings but strings.json not updated"
        fi
    else
        pass "No user-facing string changes detected"
    fi
fi

# -- Translations --

step "Translations check"
if python3 "$ROOT/scripts/check_translations.py" 2>&1; then
    pass "Translations validated"
else
    fail "Translations — see errors above"
fi

# -- Repo hygiene --
# This repo has no root npm project (the only npm project is frontend/). A stray
# root package.json / package-lock.json / node_modules — usually from an npm
# command run at the repo root by mistake — breaks `npm ci` there (ENOENT) and
# must never be committed. .gitignore covers the accidental `git add`; this also
# blocks an already-tracked or force-added (git add -f) one from being pushed.
# Pathspecs are :(top)-anchored to the repo root, so the check is correct even
# when `git push` is invoked from a subdirectory (e.g. frontend/) — a plain
# pathspec resolves relative to cwd and would wrongly match frontend/'s own
# package-lock.json.
step "Repo hygiene"
stray_npm=$(git ls-files -- ':(top)package.json' ':(top)package-lock.json' ':(top)npm-shrinkwrap.json' ':(top)node_modules' || true)
if [ -z "$stray_npm" ]; then
    pass "No stray root npm artifacts"
else
    fail "Stray root npm artifact(s) tracked (npm project is frontend/, not root) — remove with: git rm -r --cached $(echo "$stray_npm" | tr '\n' ' ')"
fi

# -- Python (only if Python code changed) --

if [ -n "$py_changed" ]; then

step "Python format check"
if ruff format --check "$ROOT/custom_components/" "$ROOT/tests/" "$ROOT/firmware/" 2>&1; then
    pass "Python formatting"
else
    fail "Python formatting — run: ruff format custom_components/ tests/ firmware/"
fi

step "Python lint"
if ruff check "$ROOT/custom_components/" "$ROOT/tests/" "$ROOT/firmware/" 2>&1; then
    pass "Python lint"
else
    fail "Python lint — run: ruff check --fix custom_components/ tests/ firmware/"
fi

step "Python tests + coverage"
# Unset git env vars set by the hook context — otherwise subprocess git calls
# inside tests inherit GIT_DIR and break when they try to operate on tmp_path
# fixtures (relevant to tests/test_release_script.py).
if (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; python -m pytest "$ROOT/tests/" -x -q --cov=custom_components/eppgrid --cov-fail-under=90 2>&1); then
    pass "Python tests + coverage"
else
    fail "Python tests + coverage"
fi

fi # python changed

# -- C++ (only if firmware code changed) --

if echo "$changed_files" | grep -q "^firmware/"; then

CPP_LIB="$ROOT/firmware/lib/epp_zone_engine"
CPP_BUILD="$CPP_LIB/build-coverage"
HELPERS_LIB="$ROOT/firmware/lib/epp_component_helpers"
HELPERS_BUILD="$HELPERS_LIB/build-coverage"

step "C++ build (coverage)"
# Unset git env vars set by the hook context — they break FetchContent's git clone
if (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; cmake -B "$CPP_BUILD" -S "$CPP_LIB" -DCMAKE_BUILD_TYPE=Coverage -DCMAKE_POLICY_VERSION_MINIMUM=3.5 2>&1 \
    && cmake --build "$CPP_BUILD" 2>&1); then
    pass "C++ build (zone engine)"
else
    fail "C++ build (zone engine)"
fi

if (unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE; cmake -B "$HELPERS_BUILD" -S "$HELPERS_LIB" -DCMAKE_BUILD_TYPE=Coverage -DCMAKE_POLICY_VERSION_MINIMUM=3.5 2>&1 \
    && cmake --build "$HELPERS_BUILD" 2>&1); then
    pass "C++ build (component helpers)"
else
    fail "C++ build (component helpers)"
fi

step "C++ tests"
if [ "$failed" -eq 0 ] && (cd "$CPP_BUILD" && ctest --output-on-failure) 2>&1; then
    pass "C++ tests (zone engine)"
else
    fail "C++ tests (zone engine)"
fi

if [ "$failed" -eq 0 ] && (cd "$HELPERS_BUILD" && ctest --output-on-failure) 2>&1; then
    pass "C++ tests (component helpers)"
else
    fail "C++ tests (component helpers)"
fi

step "C++ coverage"
if [ "$failed" -eq 0 ] && command -v lcov >/dev/null 2>&1; then
    lcov --capture --directory "$CPP_BUILD" --output-file "$CPP_BUILD/coverage.info" \
        --ignore-errors inconsistent,format 2>&1
    lcov --extract "$CPP_BUILD/coverage.info" '*/src/*.cpp' \
        --output-file "$CPP_BUILD/coverage-filtered.info" \
        --ignore-errors unused 2>&1
    cpp_cov=$(lcov --summary "$CPP_BUILD/coverage-filtered.info" 2>&1 \
        | grep 'lines\.\.' | sed 's/.*: *\([0-9]*\.[0-9]*\)%.*/\1/')
    printf '  C++ line coverage (zone engine): %s%%\n' "$cpp_cov"
    if [ "$(echo "$cpp_cov < 90" | bc)" -eq 1 ]; then
        fail "C++ coverage ${cpp_cov}% < 90%"
    else
        pass "C++ coverage ${cpp_cov}%"
    fi
    # epp_component_helpers is header-only (templated/inline), so lcov sees
    # nothing in src/. Coverage of the helpers is implicit in their host tests
    # — every code path the firmware uses is exercised there.
elif ! command -v lcov >/dev/null 2>&1; then
    printf '  \033[1;33m⚠  lcov not installed — skipping coverage check (brew install lcov)\033[0m\n'
fi

rm -rf "$CPP_BUILD" "$HELPERS_BUILD"

fi # firmware changed

# -- TypeScript (only if the frontend changed) --

if [ -n "$ts_changed" ]; then

step "TypeScript format check"
if (cd "$FRONTEND" && npx biome format src/) 2>&1; then
    pass "TypeScript formatting"
else
    fail "TypeScript formatting — run: cd frontend && npx biome format --write src/"
fi

step "TypeScript lint"
if (cd "$FRONTEND" && npx biome check src/) 2>&1; then
    pass "TypeScript lint"
else
    fail "TypeScript lint — run: cd frontend && npx biome check --fix src/"
fi

step "TypeScript build"
if (cd "$FRONTEND" && npm run build) 2>&1; then
    pass "TypeScript build"
else
    fail "TypeScript build"
fi

step "TypeScript tests + coverage"
if (cd "$FRONTEND" && npm run test:coverage) 2>&1; then
    pass "TypeScript tests + coverage"
else
    fail "TypeScript tests + coverage"
fi

# The unit suite runs under happy-dom, which has NO layout engine: clientHeight is
# always 0 and getBoundingClientRect() returns zeros. Every geometry regression
# (#338, #339) therefore passes vacuously there — the ONLY tests that can catch
# them are the real-Chromium ones. Gate on them here, not just in CI.
step "TypeScript browser tests (real layout)"
if (cd "$FRONTEND" && npm run test:browser) 2>&1; then
    pass "TypeScript browser tests"
else
    fail "TypeScript browser tests — if Chromium is missing, run: cd frontend && npx playwright install chromium"
fi

fi # frontend changed

# -- Result --

echo ""
if [ "$failed" -ne 0 ]; then
    printf '\033[1;31m✗ Pre-push checks failed. Push aborted.\033[0m\n'
    printf '\n\033[1mFailures:\033[0m\n'
    # Strip ANSI and filter to the ✗ summary lines so the user sees exactly
    # what failed without scrolling through the full output.
    # perl for the ANSI strip — BSD sed (macOS) doesn't support \xHH escapes.
    perl -pe 's/\e\[[0-9;]*m//g' "$LOG_FILE" | grep -E "^✗ " | sed 's/^/  /'
    printf '\n\033[1mFull log:\033[0m %s\n' "$LOG_FILE"
    exit 1
else
    printf '\033[1;32m✓ All pre-push checks passed.\033[0m\n'
fi
